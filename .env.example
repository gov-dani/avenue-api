NODE_ENV=development
PORT=4000
HOST=0.0.0.0
# Em producao, gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Origens permitidas (CORS), separadas por virgula
WEB_ORIGIN=http://localhost:3000
# URL publica do site: para onde o usuario volta depois do login
WEB_URL=http://localhost:3000
DB_PATH=./data/avenue.db

# Login com Discord: https://discord.com/developers/applications
# 1. New Application  2. OAuth2 > Client ID e Client Secret  3. OAuth2 > Redirects: adicione a URI abaixo
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Tem que ser IDENTICA a que voce cadastrou no portal. Passa pelo site (/api/...), nao direto pela API.
DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/discord/callback

# Bot de presença (jogo atual dos membros). Opcional.
# 1) No mesmo app: Bot > ative "Presence Intent", copie o token
# 2) Convide o bot ao servidor da Avenue (OAuth2 > URL Generator > scope bot)
# 3) Id do servidor: Discord > Configurações > Avançado > Modo desenvolvedor > botão direito no servidor > Copiar ID
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
